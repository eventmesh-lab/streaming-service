# Environment variables for Docker Compose
# Copy this file to .env and adjust values as needed

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=streaming_pass_2024
MONGO_DATABASE=streaming_db

# RabbitMQ Configuration
RABBITMQ_USER=streaming_user
RABBITMQ_PASSWORD=streaming_pass_2024

# Streaming API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=7001
API_HTTPS_PORT=7002

# JWT Configuration (should match Keycloak)
JWT_SECRET=super_secret_key_1234567890_min_length_32_chars_required
JWT_ISSUER=https://keycloak.eventmesh.com
JWT_AUDIENCE=streaming-service

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
